[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%loading%,%10%\%CUR_DIR%\%waiting%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%arrows%,%10%\%CUR_DIR%\%vertical%,%10%\%CUR_DIR%\%horizontal%,%10%\%CUR_DIR%\%diagonal_left%,%10%\%CUR_DIR%\%diagonal_right%"

[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\%pointer%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\%loading%"
HKCU,"Control Panel\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\%waiting%"
HKCU,"Control Panel\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\%link%"
HKCU,"Control Panel\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\%help%"
HKCU,"Control Panel\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\%arrows%"
HKCU,"Control Panel\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\%vertical%"
HKCU,"Control Panel\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\%horizontal%"
HKCU,"Control Panel\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\%diagonal_left%"
HKCU,"Control Panel\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\%diagonal_right%"

[Scheme.Cur]
"pointer.ani"
"loading.ani"
"waiting.ani"
"link.cur"
"help.cur"
"arrows.ani"
"vertical.ani"
"horizontal.ani"
"diagonal-left.ani"
"diagonal-right.ani"

[Strings]
CUR_DIR        = "Cursors\Kexi's Pizza Cursor"
SCHEME_NAME    = "Kexi's Pizza Cursor"
pointer		     = "pointer.ani"
loading		     = "loading.ani"
waiting		     = "waiting.ani"
link		       = "link.cur"
help		       = "help.cur"
arrows		     = "arrows.ani"
vertical		   = "vertical.ani"   
horizontal		 = "horizontal.ani"
diagonal_left  = "diagonal-left.ani"
diagonal_right = "diagonal-right.ani"
